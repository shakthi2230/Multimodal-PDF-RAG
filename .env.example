# Copy to .env and set a long, unique secret before deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60

# Local development can use SQLite; Docker Compose uses PostgreSQL.
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag

# Qdrant vector store
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_chunks
QDRANT_PATH=/app/storage/qdrant

# AI services (required for embeddings, generated answers, and vision descriptions)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PDF ingestion
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500

# Browser origins allowed by the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
